<?xml version="1.0" encoding="utf-8"?>
<!-- Production policy: cleartext HTTP is BLOCKED. Backup codes and sync data
     must travel over HTTPS. The debug source set overrides this file to allow
     cleartext so the Android emulator can reach the local dev server
     (http://10.0.2.2:4000); release builds never allow it. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
